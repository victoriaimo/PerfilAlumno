<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PerfilAlumno.MainPage"
    Title="Mi Perfil"
    BackgroundColor="#F3F4F6">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20"
            MaximumWidthRequest="600">

            <!-- Título -->
            <Label
                Text="Mi Perfil"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#1F2937"
                HorizontalOptions="Center" />

            <Label
                Text="Perfil del alumno"
                FontSize="16"
                TextColor="#6B7280"
                HorizontalOptions="Center" />

            <!-- Tarjeta -->
            <Border
                BackgroundColor="White"
                Padding="25"
                Stroke="#E5E7EB"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <!-- Imagen -->
                    <Border
                        HeightRequest="160"
                        WidthRequest="160"
                        HorizontalOptions="Center"
                        Stroke="#D1D5DB"
                        StrokeThickness="2">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="80" />
                        </Border.StrokeShape>

                        <Image
                            Source="{Binding ImagenPerfil}"
                            Aspect="AspectFill"
                            HeightRequest="160"
                            WidthRequest="160" />

                    </Border>

                    <!-- URL de imagen -->
                    <Label
                        Text="Imagen de perfil"
                        FontAttributes="Bold"
                        TextColor="#374151" />

                    <Entry
                        Text="{Binding ImagenPerfil, Mode=TwoWay}"
                        Placeholder="URL o nombre de imagen"
                        BackgroundColor="#F9FAFB" />

                    <!-- Nombre -->
                    <Label
                        Text="Nombre"
                        FontAttributes="Bold"
                        TextColor="#374151" />

                    <Entry
                        Text="{Binding Nombre, Mode=TwoWay}"
                        Placeholder="Ingrese su nombre"
                        BackgroundColor="#F9FAFB" />

                    <!-- Edad -->
                    <Label
                        Text="Edad"
                        FontAttributes="Bold"
                        TextColor="#374151" />

                    <Entry
                        Text="{Binding Edad, Mode=TwoWay}"
                        Keyboard="Numeric"
                        Placeholder="Ingrese su edad"
                        BackgroundColor="#F9FAFB" />

                    <!-- Descripción -->
                    <Label
                        Text="Descripción"
                        FontAttributes="Bold"
                        TextColor="#374151" />

                    <Editor
                        Text="{Binding Descripcion, Mode=TwoWay}"
                        Placeholder="Escriba una breve descripción"
                        HeightRequest="110"
                        BackgroundColor="#F9FAFB" />

                    <!-- Botón -->
                    <Button
                        Text="Guardar perfil"
                        Command="{Binding GuardarCommand}"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="50"
                        CornerRadius="12"
                        Margin="0,10,0,0" />

                </VerticalStackLayout>

            </Border>

            <Label
                Text="Desarrollo de Aplicaciones Móviles II"
                FontSize="12"
                TextColor="#9CA3AF"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>